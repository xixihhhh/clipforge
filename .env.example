# PostgreSQL connection used by the SaaS web application and Drizzle migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipforge

# Supabase Auth public configuration (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe subscriptions. Keep secrets server-only and use a recurring Pro Price ID.
# Never expose these values with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
PRO_MONTHLY_CREDITS=1000

# Public canonical origin used only for Stripe success/cancel/portal return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
