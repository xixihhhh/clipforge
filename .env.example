# PostgreSQL connection used by the SaaS web application and Drizzle migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clipforge

# Supabase Auth public configuration (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Future Stripe server integration. Leave blank until checkout/webhooks are implemented.
# Never expose these values with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_TEAM=
